{
  "name": "@lin_arm/gkd_subscription",
  "version": "0.0.0",
  "type": "module",
  "gkd": {
    "outDir": "dist",
    "file": "gkd.json5",
    "versionFile": "gkd.version.json5",
    "changelog": "CHANGELOG.md",
    "README.md": "README.md"
  },
  "scripts": {
    "postinstall": "simple-git-hooks",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "check": "tsc --noEmit -p tsconfig.jsonc && tsx ./scripts/check.ts",
    "build": "tsc --noEmit -p tsconfig.jsonc && tsx ./scripts/build.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --config commitlint.config.ts --edit ${1}",
    "pre-push": "pnpm run check && bash scripts/python/tests/run_tests.sh"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,jsx,tsx,json,jsonc}": [
      "biome check --write"
    ],
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "./dist"
  ],
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@gkd-kit/api": "0.9.3",
    "@gkd-kit/define": "0.0.1",
    "@gkd-kit/tools": "0.8.0",
    "@types/node": "26.6.3",
    "json5": "2.2.3",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "volta": {
    "node": "24.17.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engineStrict": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
